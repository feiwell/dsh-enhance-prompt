{
  "name": "dsh-enhance-prompt",
  "version": "0.2.0",
  "description": "在输入栏一键把草稿改写成更清晰、更具体的提示词：日常办公 / 代码开发 / 设计创意三种收束模式，网页端与桌面端通用。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek",
    "deepseek-harness",
    "cordis",
    "prompt",
    "prompt-engineering",
    "prompt-enhance",
    "composer",
    "web-ui"
  ],
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "assets/readme",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT",
  "author": "feiwell",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/feiwell/dsh-enhance-prompt.git"
  },
  "homepage": "https://github.com/feiwell/dsh-enhance-prompt#readme",
  "bugs": {
    "url": "https://github.com/feiwell/dsh-enhance-prompt/issues"
  },
  "engines": {
    "node": ">=22.19.0",
    "dsh": ">=0.2.1-rc.2 <0.3.0-0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
